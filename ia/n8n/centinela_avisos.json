      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        260
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Avisa solo cuando cambia el servidor que atiende (JE → JP, JP → JE, o caída total)\nconst memoria = $getWorkflowStaticData('global');\nconst estado = $input.first().json;\nconst activo = estado.activo || 'NINGUNO';\nconst anterior = memoria.activo;\nmemoria.activo = activo;\nif (anterior === undefined || anterior === activo) return [];\nconst hora = new Date().toLocaleTimeString('es-CO', { timeZone: 'America/Bogota', hour12: false });\nlet msg;\nif (activo === 'JP') msg = `⚠️ ${hora} · JE dejó de responder. JP tomó el control y el servicio sigue funcionando.`;\nelse if (activo === 'JE') msg = `✅ ${hora} · JE volvió y retomó como servidor principal.`;\nelse msg = `🚨 ${hora} · Ningún servidor responde. Revisa JE y JP.`;\nreturn [{ json: { respuesta: msg } }];"
      },
      "id": "88a3ec96-6346-4605-a10f-da2d8bca6d0f",
      "name": "¿Cambió el servidor?",
